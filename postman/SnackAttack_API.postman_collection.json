      "name": "01 - Products (US_06 / US_07)",
      "item": [
        {
          "name": "TC_API_01 – Ürünleri listele",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Yanıt süresi < 3000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const body = pm.response.json();",
                  "pm.test(\"Toplam 28 ürün\", () => pm.expect(body.totalElements).to.eql(28));",
                  "pm.test(\"Sayfa boyutu 10\", () => pm.expect(body.content.length).to.eql(10));",
                  "pm.test(\"Tüm fiyatlar pozitif\", () => body.content.forEach(p => pm.expect(p.price).to.be.above(0)));",
                  "pm.test(\"Şema: id, name, price, categories\", () => body.content.forEach(p => pm.expect(p).to.include.all.keys(\"id\", \"name\", \"price\", \"categories\")));",
                  "pm.collectionVariables.set(\"productId\", body.content[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/allProduct-client?search=&page=0&size=10",
              "host": [
                "{{baseUrl}}"
